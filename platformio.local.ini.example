; =============================================================================
; Local development override (copy to platformio.local.ini — gitignored).
;
; RELEASE builds use the committed [mcrpc_lib] in platformio.ini
;   (GitHub tag, later PlatformIO Registry).
;
; DEVELOPMENT: use the sibling checkout under /data/projects/mcrpc
; =============================================================================

[mcrpc_lib]
lib = symlink://../mcrpc

; Optional alternatives:
; lib = file://../mcrpc
; lib = https://github.com/tj57/mcrpc.git#v1.0.0
; lib = mcrpc @ ^1.0.0          ; after registry publish
