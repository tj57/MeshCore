; =============================================================================
; Lab channel secrets — COPY to platformio.secrets.ini (gitignored).
;
; Never commit platformio.secrets.ini. Real PSKs stay on the build machine only.
;
; Hex PSK = same 32-char form as MeshCore companion / HA channel_secret.
; MCRPC_FORCE_CHANNEL_DEFAULTS=1 rewrites /mcrpc_cfg on boot (lab flash).
; =============================================================================

[env:Heltec_v3_mcrpc_button]
build_flags =
  ${heltec_v3_mcrpc_button.build_flags}
  -D MCRPC_DEFAULT_CHANNEL='"mcCtrl"'
  -D MCRPC_DEFAULT_PSK_HEX='"REPLACE_WITH_32_HEX_CHARS"'
  -D MCRPC_FORCE_CHANNEL_DEFAULTS=1

[env:Heltec_v3_mcrpc_button_debug]
build_flags =
  ${heltec_v3_mcrpc_button.build_flags}
  -D MESH_DEBUG=1
  -D MCRPC_DEFAULT_CHANNEL='"mcCtrl"'
  -D MCRPC_DEFAULT_PSK_HEX='"REPLACE_WITH_32_HEX_CHARS"'
  -D MCRPC_FORCE_CHANNEL_DEFAULTS=1

[env:LW010_mcrpc_gps]
build_flags =
  ${lw010_mcrpc_gps.build_flags}
  -D MCRPC_DEFAULT_CHANNEL='"mcCtrl"'
  -D MCRPC_DEFAULT_PSK_HEX='"REPLACE_WITH_32_HEX_CHARS"'
  -D MCRPC_FORCE_CHANNEL_DEFAULTS=1

[env:RAK_WisMesh_Tag_mcrpc_gps]
build_flags =
  ${lw010_mcrpc_gps.build_flags}
  -D MCRPC_DEFAULT_CHANNEL='"mcCtrl"'
  -D MCRPC_DEFAULT_PSK_HEX='"REPLACE_WITH_32_HEX_CHARS"'
  -D MCRPC_FORCE_CHANNEL_DEFAULTS=1
